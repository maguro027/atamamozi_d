{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: clean",
            "type": "shell",
            "command": "mvn clean",
            "group": "build",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Maven: package (skip tests)",
            "type": "shell",
            "command": "mvn -B -DskipTests package",
            "group": "build",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Maven: package (run tests)",
            "type": "shell",
            "command": "mvn -B package",
            "group": "build",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Maven: test",
            "type": "shell",
            "command": "mvn -B test",
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}